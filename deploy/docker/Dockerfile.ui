# Photobuy sotuv — veb-panel (Next.js, standalone)
FROM node:24-alpine AS build
WORKDIR /w
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
# BACKEND_URL va SECURE next.config.mjs da yig'ilish vaqtida o'qiladi (rewrites va HSTS)
ENV NODE_ENV=production \
    BACKEND_URL=http://sales-api:8200 \
    SECURE=1
RUN npx tsc --noEmit && npm run build

FROM node:24-alpine
RUN apk add --no-cache tzdata
ENV NODE_ENV=production \
    TZ=Asia/Tashkent \
    PORT=3000 \
    HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build --chown=node:node /w/.next/standalone ./
USER node
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/login >/dev/null || exit 1

CMD ["node", "server.js"]
